{
  "name": "shadowcat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "build": "pnpm --filter @shadowcat/shell build",
    "docs:api:rust": "cargo doc --manifest-path src/server/Cargo.toml --document-private-items --no-deps",
    "docs:api:ts": "typedoc",
    "docs:dev": "vitepress dev docs/site",
    "docs:build:portal": "vitepress build docs/site",
    "check:svelte-runtime": "node scripts/check-svelte-runtime-entries.mjs",
    "test:scripts": "vitest run scripts/check-svelte-runtime-entries.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
