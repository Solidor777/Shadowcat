# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Debug Dumps folder
/debug/dumps/

# Node
node_modules/

# Client build output
/dist/
# Worked-example lib builds (rebuilt by CI; guides code-import the sources)
examples/*/dist/

# TS incremental build info
*.tsbuildinfo

# Personal local Claude Code settings (permission allowlist, etc.)
.claude/settings.local.json
.claude/settings.json
# Auto-generated graphify skill stays local; project-authored codebase skills are committed.
.claude/skills/graphify/
# Fixed, reused-in-place throwaway directory `check-skill-symbol-refs.test.mjs`'s listSkillDirs
# suite writes so it has a real untracked directory to assert against without depending on
# graphify actually having been generated locally (a fresh CI checkout never has it).
.claude/skills/__listskilldirs_test_fixture__/
/CLAUDE.md

# graphify knowledge-graph output (regenerated by `graphify update`)
graphify-out/
test-results/
playwright-report/

# Binary runtime asset store (uploaded files land in assets/<uuid>/; icons stay tracked)
/assets/*/

# Brainstorming visual-companion scratch
.superpowers/

# Docs pipeline output (assembled site, generator scratch, VitePress cache/dist)
dist-docs/
.docs-tmp/
docs/site/.vitepress/cache/
docs/site/.vitepress/dist/

# Kimi Code plugin shim + per-repo agent copies (local install artifacts)
.claude/kimi.plugin.json
.kimi-code/
